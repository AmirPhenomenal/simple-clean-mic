{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clean Mic",
  "version": "0.1.0",
  "identifier": "com.simplecleanmic.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Clean Mic",
        "width": 440,
        "height": 820,
        "minWidth": 400,
        "minHeight": 500,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
